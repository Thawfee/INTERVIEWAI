# ============================================================
# InterviewAI — Environment configuration (example)
# Copy this file to `.env` and fill in real values.
# NEVER commit your real .env file or expose secret keys in the frontend.
# ============================================================

# Base URL of your own backend proxy that talks to the AI providers.
# The frontend should ONLY ever call your backend, never the providers directly.
VITE_API_URL=

# Toggle between the built-in mock engine and a real backend.
# "mock" (default) uses src/services/ai/mockAI.ts — no keys required.
# "live" routes calls through VITE_API_URL.
VITE_AI_MODE=mock

# ---- Keys below belong on the SERVER, not in the browser bundle ----
# They are listed here only to document what your backend will need.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=
